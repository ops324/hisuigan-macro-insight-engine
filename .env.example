# ローカル開発用テンプレート。.env.local にコピーして実際の値を入力してください。
# APIキーは .env.local のみに保存し、チャットやコミットに含めないこと。

# FRED API（米国債利回り取得に必須）
# 取得方法：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# 任意：絶対URLの基点を上書き（未設定時は Vercel 本番URL → localhost にフォールバック）
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
